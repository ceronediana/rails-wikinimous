<h1><%= @article.title %></h1>
<p><%= @article.content %></p>

<p><%= link_to "✏️ Edit this Article", edit_article_path(@article) %></p>

<%= link_to "Delete",
  article_path(@article),
  data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
%>

<p><%= link_to "🔙 Back to list", articles_path %></p>
